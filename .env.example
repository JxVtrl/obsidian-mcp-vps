# Copy to .env and fill in. install.sh generates the two secrets for you.

# Public URL of the MCP endpoint (the hostname you route through the tunnel).
EXTERNAL_URL=https://mcp.example.com

# Where the vault lives on the server.
VAULT_DIR=/opt/vault

# Password you type once in the browser when connecting an MCP client.
PASSWORD=

# Static bearer token, for clients that cannot do the OAuth flow.
PROXY_BEARER_TOKEN=
